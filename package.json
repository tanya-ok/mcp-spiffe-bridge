{
  "name": "mcp-spiffe-bridge",
  "version": "0.0.1",
  "description": "SPIFFE/SPIRE workload identity for MCP servers: mTLS, SVID-based caller authentication and audit logging.",
  "keywords": [
    "mcp",
    "spiffe",
    "spire",
    "svid",
    "mtls",
    "workload-identity",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "author": "Tanya Babitskaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanya-ok/mcp-spiffe-bridge.git"
  },
  "homepage": "https://github.com/tanya-ok/mcp-spiffe-bridge#readme",
  "bugs": {
    "url": "https://github.com/tanya-ok/mcp-spiffe-bridge/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests examples scripts",
    "lint:fix": "biome check --write src tests examples scripts",
    "format": "biome format --write src tests examples scripts"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0 <2.0.0"
  },
  "dependencies": {
    "spiffe": "^0.5.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@peculiar/x509": "^1.14.3",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
