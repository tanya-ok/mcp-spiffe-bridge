{
  "name": "mcp-spiffe-bridge",
  "version": "0.0.1",
  "description": "SPIFFE/SPIRE workload identity for MCP servers: mTLS, SVID-based caller authentication and audit logging.",
  "keywords": [
    "mcp",
    "spiffe",
    "spire",
    "svid",
    "mtls",
    "workload-identity",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "author": "Tanya Babitskaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanya-ok/mcp-spiffe-bridge.git"
  },
  "homepage": "https://github.com/tanya-ok/mcp-spiffe-bridge#readme",
  "bugs": {
    "url": "https://github.com/tanya-ok/mcp-spiffe-bridge/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/build-cjs-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests examples scripts deploy",
    "lint:fix": "biome check --write src tests examples scripts deploy",
    "format": "biome format --write src tests examples scripts deploy",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm build && pnpm run check:package",
    "bench:spire": "deploy/spire-lab/bench.sh"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.32.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "spiffe": "^0.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@peculiar/x509": "^2.2.0",
    "@types/node": "^26.6.6",
    "reflect-metadata": "^0.2.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
